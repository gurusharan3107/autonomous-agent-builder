/**
 * REPLACE-NAME — Floating cursor overlay
 *
 * Visible animated cursor that shows where the extension / agent is acting.
 *
 * Encodes the hard-won lessons from hermes-chrome:
 *   - Host has pointer-events: none — elementFromPoint already skips it.
 *     No defensive hide/show dance around click handlers.
 *   - createOverlay() preserves prior position + visibility on re-injection,
 *     so service-worker idle restart doesn't reset the cursor to (-100,-100).
 *   - Compositor-driven CSS transform glide so motion survives Chrome
 *     backgrounding.
 *
 * Don't simplify by removing the preservation logic or by reintroducing the
 * hide-flash pattern — both were specifically fixed after operator-visible
 * regressions.
 */
(() => {
  if (document.documentElement.dataset.replaceCursorInjected) {
    try { void chrome.runtime.id; return; }
    catch { document.documentElement.removeAttribute("data-replace-cursor-injected"); }
  }
  document.documentElement.dataset.replaceCursorInjected = "true";

  const CURSOR_ID = "REPLACE-cursor-overlay";
  const POINTER_SVG = chrome.runtime.getURL("images/pointer.svg");

  let cursorX = -100, cursorY = -100;
  let cursorEl = null, pointerEl = null;
  let isVisible = false;
  let phase = "idle";

  const css = `
    #${CURSOR_ID} {
      position: fixed;
      z-index: 2147483647;
      pointer-events: none;
      left: 0; top: 0;
      will-change: transform;
      transform: translate(-100px, -100px);
      transition: transform 0.32s cubic-bezier(0.22, 0.61, 0.36, 1), opacity 0.2s ease;
      opacity: 0;
    }
    #${CURSOR_ID}.cursor-visible { opacity: 1; }
    #${CURSOR_ID} .cursor-pointer {
      width: 18px; height: 18px; display: block;
      filter: drop-shadow(0 0 8px rgba(73, 182, 255, 0.55))
              drop-shadow(0 2px 3px rgba(0, 0, 0, 0.32));
    }
  `;

  function createOverlay() {
    // Preserve last-known position + visibility across script re-injection.
    // Without this, the cursor resets to (-100,-100) opacity:0 on SW idle
    // restart or extension reload — operator perceives it as vanished.
    const old = document.getElementById(CURSOR_ID);
    let priorTransform = null;
    let priorVisible = false;
    if (old) {
      priorTransform = old.style.transform || null;
      priorVisible = old.classList.contains("cursor-visible");
      old.remove();
    }
    const oldStyle = document.querySelector("style[data-replace-cursor-style]");
    if (oldStyle) oldStyle.remove();

    const style = document.createElement("style");
    style.dataset.replaceCursorStyle = "1";
    style.textContent = css;
    document.head.appendChild(style);

    cursorEl = document.createElement("div");
    cursorEl.id = CURSOR_ID;
    const img = document.createElement("img");
    img.className = "cursor-pointer";
    img.src = POINTER_SVG;
    img.alt = "";
    pointerEl = img;
    cursorEl.appendChild(img);
    document.documentElement.appendChild(cursorEl);

    // Restore prior state so the cursor stays parked where it was.
    if (priorTransform && priorTransform !== "none" && priorTransform.indexOf("-100") === -1) {
      cursorEl.style.transform = priorTransform;
      const m = priorTransform.match(/-?\d+(\.\d+)?/g);
      if (m && m.length >= 2) {
        const useMatrix = priorTransform.indexOf("matrix") === 0;
        cursorX = parseFloat(useMatrix ? m[4] : m[0]);
        cursorY = parseFloat(useMatrix ? m[5] : m[1]);
      }
    }
    if (priorVisible) {
      cursorEl.classList.add("cursor-visible");
      isVisible = true;
    } else {
      isVisible = false;
    }
  }

  function moveTo(x, y) {
    if (!cursorEl) createOverlay();
    cursorX = x; cursorY = y;
    if (!isVisible) {
      cursorEl.classList.add("cursor-visible");
      isVisible = true;
    }
    cursorEl.style.transform = `translate(${x}px, ${y}px)`;
  }

  function click() {
    if (!cursorEl) return;
    // The cursor host has pointer-events: none, so elementFromPoint already
    // skips it and returns the underlying page element. No hide/show dance —
    // that pattern caused visible opacity flicker on every click.
    const el = document.elementFromPoint(cursorX, cursorY);
    if (el) {
      const opts = { bubbles: true, cancelable: true, view: window };
      el.dispatchEvent(new MouseEvent("mousedown", { ...opts, clientX: cursorX, clientY: cursorY }));
      el.dispatchEvent(new MouseEvent("mouseup",   { ...opts, clientX: cursorX, clientY: cursorY }));
      el.dispatchEvent(new MouseEvent("click",     { ...opts, clientX: cursorX, clientY: cursorY }));
    }
  }

  // Listen for service-worker messages: { type: "cursor", action: "moveTo"|"click", x, y }
  chrome.runtime.onMessage.addListener((msg, sender, sendResponse) => {
    if (msg?.type !== "cursor") return;
    if (msg.action === "moveTo") moveTo(msg.x, msg.y);
    if (msg.action === "click")  click();
    sendResponse({ success: true });
  });
})();
