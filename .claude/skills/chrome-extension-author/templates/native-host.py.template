#!/usr/bin/env python3
"""
REPLACE-NAME — Native messaging host.

Long-lived process that bridges Chrome (stdio per native-messaging protocol)
with an external agent / CLI (Unix socket, line-delimited JSON).

Architecture per references/native-messaging.md:
  External agent ──unix socket──► host.py ──stdio──► Chrome SW

Encoded patterns from hermes-chrome:
  - Bind to IPv6 wildcard so Windows-side Chrome reaches WSL-side host
  - TCP_NODELAY on every connected socket (avoid Nagle's 4-9s latency)
  - Logs to stderr only; stdout is Chrome's channel
"""
import json
import os
import socket
import struct
import sys
import threading
from pathlib import Path

# ---- Chrome native-messaging protocol (stdio) -----------------------------

def chrome_read():
    """Read one length-prefixed JSON message from Chrome via stdin."""
    raw = sys.stdin.buffer.read(4)
    if not raw or len(raw) < 4:
        return None
    n = struct.unpack("<I", raw)[0]
    body = sys.stdin.buffer.read(n).decode("utf-8")
    return json.loads(body)

def chrome_write(obj):
    """Send a JSON message to Chrome via stdout with length prefix."""
    body = json.dumps(obj).encode("utf-8")
    sys.stdout.buffer.write(struct.pack("<I", len(body)))
    sys.stdout.buffer.write(body)
    sys.stdout.buffer.flush()

def log(*args):
    """Stderr only. Stdout is Chrome's channel."""
    print(*args, file=sys.stderr, flush=True)

# ---- Unix socket server (agent side) --------------------------------------

SOCK_PATH = Path.home() / ".REPLACE-SLUG" / "run" / "bridge.sock"
SOCK_PATH.parent.mkdir(parents=True, exist_ok=True)

def socket_server():
    """Accept agent connections; forward line-delimited JSON to Chrome."""
    if SOCK_PATH.exists():
        SOCK_PATH.unlink()
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(str(SOCK_PATH))
    srv.listen(8)
    log(f"native host listening on {SOCK_PATH}")
    while True:
        conn, _ = srv.accept()
        threading.Thread(target=handle_agent, args=(conn,), daemon=True).start()

def handle_agent(conn):
    """One connected agent. Reads JSON lines; relays each to Chrome."""
    with conn:
        buf = b""
        while True:
            chunk = conn.recv(65536)
            if not chunk:
                return
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                if not line:
                    continue
                try:
                    msg = json.loads(line.decode("utf-8"))
                except Exception as e:
                    log(f"bad json from agent: {e}")
                    continue
                # Forward to Chrome. The SW's onMessage listener replies via
                # chrome_write — see service_worker.js.
                chrome_write(msg)

# ---- Chrome side ----------------------------------------------------------

def chrome_loop():
    """Read messages Chrome sends us; could broadcast to connected agents."""
    while True:
        msg = chrome_read()
        if msg is None:
            log("chrome stdio closed; exiting")
            return
        log(f"from chrome: {msg}")
        # REPLACE — relay to connected agents if needed.

# ---- Main -----------------------------------------------------------------

if __name__ == "__main__":
    threading.Thread(target=socket_server, daemon=True).start()
    chrome_loop()
