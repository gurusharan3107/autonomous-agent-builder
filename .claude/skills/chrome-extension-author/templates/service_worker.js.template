/**
 * REPLACE-NAME — Service Worker (MV3)
 *
 * MV3 service workers idle after ~30s of inactivity. Globals reset on each
 * wake. Listeners re-register on every wake. Plan accordingly.
 *
 * Architectural patterns encoded here come from hermes-chrome:
 *   - ensureContentScript: probe-then-inject for resilience across SW idles
 *   - Guard chrome:// / about: URLs in tabs.onUpdated
 *   - Async onMessage handlers always return true
 *   - console.error reserved for real errors; debug traces use console.debug
 */

// Tracks tabs known to have the content script injected. Wiped on SW idle.
const injectedTabs = new Set();

// ---- Lifecycle ------------------------------------------------------------

chrome.runtime.onInstalled.addListener(() => {
  // Set initial state. chrome.storage survives reloads; in-memory does not.
  chrome.storage.local.set({ enabled: true }).catch(() => {});
});

// Auto-inject on page navigation (only if your extension needs always-present
// content scripts). Comment out if injection should be operator-triggered.
chrome.tabs.onUpdated.addListener(async (tabId, changeInfo, tab) => {
  if (changeInfo.status !== "complete") return;
  if (!tab.url) return;
  // Chrome forbids content scripts on these schemes — guarding avoids errors.
  if (tab.url.startsWith("chrome://") ||
      tab.url.startsWith("chrome-extension://") ||
      tab.url.startsWith("about:") ||
      tab.url.startsWith("view-source:")) {
    return;
  }
  if (injectedTabs.has(tabId)) return;
  try {
    await chrome.scripting.executeScript({
      target: { tabId },
      files: ["content-scripts/main.js"]
    });
    injectedTabs.add(tabId);
  } catch {
    // Will retry on next message; non-fatal here.
  }
});

chrome.tabs.onRemoved.addListener((tabId) => {
  injectedTabs.delete(tabId);
});

// ---- Probe-then-inject ----------------------------------------------------

async function ensureContentScript(tabId) {
  if (injectedTabs.has(tabId)) return { injected: true };
  try {
    const ping = await chrome.tabs.sendMessage(tabId, { type: "ping" });
    if (ping?.ok) {
      injectedTabs.add(tabId);
      return { injected: true };
    }
  } catch {
    // CS not present; fall through to inject.
  }
  try {
    await chrome.scripting.executeScript({
      target: { tabId },
      files: ["content-scripts/main.js"]
    });
    injectedTabs.add(tabId);
    return { injected: true };
  } catch (e) {
    return { injected: false, reason: String(e?.message || e) };
  }
}

// ---- Message bus ----------------------------------------------------------

chrome.runtime.onMessage.addListener((msg, sender, sendResponse) => {
  if (!msg || typeof msg !== "object") {
    sendResponse({ success: false, error: "invalid message" });
    return;
  }

  if (msg.type === "ping") {
    sendResponse({ ok: true });
    return;  // sync path — do not return true
  }

  // Async path: ALWAYS return true to keep the message channel open.
  (async () => {
    try {
      // Route by msg.type / msg.action
      if (msg.type === "REPLACE-ACTION") {
        const result = await doSomething(msg.args, sender);
        sendResponse({ success: true, result });
      } else {
        sendResponse({ success: false, error: `unknown type: ${msg.type}` });
      }
    } catch (e) {
      // Real error — appropriate to use console.error here.
      console.error("onMessage handler failed:", e);
      sendResponse({ success: false, error: String(e?.message || e) });
    }
  })();
  return true;
});

// ---- Domain handlers ------------------------------------------------------

async function doSomething(args, sender) {
  // REPLACE — your extension's main work goes here.
  // If you need the content script on the sender's tab, call ensureContentScript first.
  return { echo: args };
}
